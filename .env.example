APP_ENV=local
DATABASE_URL=sqlite:///./enterprise_ai_assistant.db

# Local development only. Replace this value before sharing an environment.
AGENT_TOOL_API_KEY=replace-with-a-random-local-key

# OpenClaw plugin/client-side helpers. Use the same value as AGENT_TOOL_API_KEY
# when configuring OpenClaw through a SecretRef or gateway environment variable.
ENTERPRISE_AI_BACKEND_URL=http://127.0.0.1:8000
ENTERPRISE_AI_AGENT_TOOL_API_KEY=replace-with-a-random-local-key

# Optional: prefill the frontend API key during local Vite development.
# Do not set this in public deployments.
VITE_AGENT_TOOL_API_KEY=
